[Unit]
Description=Dream Coach backend (Bun + Hono + MCP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %h = the service user's home. The checkout and secrets live under it.
WorkingDirectory=%h/deployments/dream-coach-git/backend
EnvironmentFile=%h/deployments/.secrets/dream-coach/secrets.env
Environment=PORT=8130
# Bun runs TypeScript directly; drizzle migrations auto-apply at boot.
ExecStart=%h/.bun/bin/bun run serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
