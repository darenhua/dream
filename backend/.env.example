PORT=3001
# Set BIND_HOST=127.0.0.1 when a local TLS reverse proxy fronts both /api and
# /mcp. The default 0.0.0.0 preserves the existing direct-development setup.
BIND_HOST=0.0.0.0
DB_PATH=./data/dream.db
WORKSPACE_PATH=./workspace

# inference provider: true = AWS Bedrock (uses AWS credential chain + AWS_REGION),
# false = first-party Anthropic API (uses ANTHROPIC_API_KEY)
USE_BEDROCK=true
AWS_REGION=us-west-2
ANTHROPIC_API_KEY=sk-ant-...

# outbound proxy for SDK traffic: true routes through PROXY_URL (falls back to
# shell HTTPS_PROXY), false forces direct egress even if the shell exports a proxy
USE_PROXY=false
PROXY_URL=http://127.0.0.1:3213

# google calendar (Desktop-app OAuth client from console.cloud.google.com;
# keep the consent screen in Testing mode with yourself as a test user)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Remote MCP collaboration (ChatGPT/Claude): serve /mcp from a publicly
# reachable HTTPS origin. MCP_PUBLIC_URL is the origin only (no /mcp path).
# Server-to-server MCP clients may legitimately omit Origin; only add browser
# origins you intentionally support. Do not put a dashboard or OTP secret here.
MCP_PUBLIC_URL=https://dream.example.com
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=dream.example.com
# Set true only behind a private TLS reverse proxy that overwrites all
# X-Forwarded-* headers; otherwise leave false.
MCP_TRUST_PROXY=false
MCP_SESSION_IDLE_MINUTES=30
MCP_MAX_SESSIONS=100
MCP_REDEEM_MAX_ATTEMPTS=8
MCP_REDEEM_WINDOW_MINUTES=15
MCP_REDEEM_MAX_TRACKED_CLIENTS=10000
